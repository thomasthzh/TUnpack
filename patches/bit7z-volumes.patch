         void setLargePageMode();
 
+        // LightUnpack extension: map explicit, renamed native RAR/ZIP volumes without copying files.
+        // Thread-local hooks allow safe concurrent archive operations sharing one Bit7zLibrary.
+        using VolumeResolver = std::function<tstring(const tstring&)>;
+        struct VolumeHooks {
+            VolumeResolver resolver;
+            tstring virtualVolumeName;
+            std::function<void(const tstring&)> observer;
+        };
+        static auto volumeHooks() -> VolumeHooks& {
+            thread_local VolumeHooks hooks;
+            return hooks;
+        }
+        void setVolumeResolver(VolumeResolver resolver, tstring firstName = {}) {
+            auto& h = volumeHooks();
+            h.resolver = std::move(resolver);
+            h.virtualVolumeName = std::move(firstName);
+        }
+        auto volumeResolver() const -> const VolumeResolver& { return volumeHooks().resolver; }
+        auto virtualVolumeName() const -> const tstring& { return volumeHooks().virtualVolumeName; }
+        void setVolumeObserver(std::function<void(const tstring&)> observer) { volumeHooks().observer = std::move(observer); }
+        auto volumeObserver() const -> const std::function<void(const tstring&)>& { return volumeHooks().observer; }
+
